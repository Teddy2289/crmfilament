<x-filament-panels::page>
    {{-- Sidebar panneau de contrôle --}}
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-6">
        {{-- Panneau de gauche : statut et filtres --}}
        <div class="lg:col-span-1 space-y-4">
            {{-- Statut Google --}}
            <div class="rounded-2xl border @if(! $isGoogleConnected) border-amber-200 bg-gradient-to-br from-amber-50 to-amber-100 dark:border-amber-800 dark:from-amber-950 dark:to-amber-900 @else border-emerald-200 bg-gradient-to-br from-emerald-50 to-emerald-100 dark:border-emerald-800 dark:from-emerald-950 dark:to-emerald-900 @endif p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    @if(! $isGoogleConnected)
                        <x-heroicon-o-exclamation-triangle class="h-6 w-6 text-amber-500 shrink-0" />
                        <div>
                            <p class="text-sm font-semibold text-amber-800 dark:text-amber-200">Google Calendar non connecté</p>
                            <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">Connectez votre compte pour synchroniser vos RDV</p>
                        </div>
                    @else
                        <x-heroicon-o-check-circle class="h-6 w-6 text-emerald-500 shrink-0" />
                        <div>
                            <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">Google Calendar connecté</p>
                            <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1">Synchronisation automatique active</p>
                        </div>
                    @endif
                </div>
            </div>

            {{-- Légende RDV CRM --}}
            <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-4 shadow-sm">
                <div class="flex items-center gap-2 mb-3">
                    <x-heroicon-o-calendar class="h-4 w-4 text-gray-500 dark:text-gray-400" />
                    <p class="text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Types de RDV</p>
                </div>
                <div class="space-y-2">
                    <div class="flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#0ea5e9] ring-2 ring-[#0ea5e9]/20"></span>
                        <span>Appel</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#10b981] ring-2 ring-[#10b981]/20"></span>
                        <span>Permanence</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#6366f1] ring-2 ring-[#6366f1]/20"></span>
                        <span>Présentation</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#f97316] ring-2 ring-[#f97316]/20"></span>
                        <span>Intervention</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#9ca3af] ring-2 ring-[#9ca3af]/20"></span>
                        <span>Annulé</span>
                    </div>
                </div>
            </div>

            {{-- Légende Google interactive --}}
            <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-4 shadow-sm"
                x-data="{
                    hidden: JSON.parse(localStorage.getItem('hiddenGoogleCalendars') || '[]'),
                    applyVisibility(id) {
                        document.querySelectorAll('[data-calendar-id]').forEach(el => {
                            if (el.dataset.calendarId === id) {
                                el.style.display = this.hidden.includes(id) ? 'none' : '';
                            }
                        });
                    },
                    toggle(id) {
                        this.hidden = this.hidden.includes(id)
                            ? this.hidden.filter(value => value !== id)
                            : [...this.hidden, id];
                        localStorage.setItem('hiddenGoogleCalendars', JSON.stringify(this.hidden));
                        this.applyVisibility(id);
                    },
                    showAll() {
                        this.hidden = [];
                        localStorage.setItem('hiddenGoogleCalendars', JSON.stringify(this.hidden));
                        document.querySelectorAll('[data-calendar-id]').forEach(el => el.style.display = '');
                    },
                    hideAll() {
                        this.hidden = @js(array_keys($googleCalendars));
                        localStorage.setItem('hiddenGoogleCalendars', JSON.stringify(this.hidden));
                        document.querySelectorAll('[data-calendar-id]').forEach(el => el.style.display = 'none');
                    },
                }"
            >
                <div class="flex items-center justify-between gap-2 mb-3">
                    <div class="flex items-center gap-2">
                        <x-heroicon-o-calendar-days class="h-4 w-4 text-gray-500 dark:text-gray-400" />
                        <p class="text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Calendriers Google</p>
                    </div>
                    @if(count($googleCalendars) > 0)
                        <div class="flex items-center gap-1">
                            <button type="button" @click="showAll()" class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors" title="Tout afficher">
                                <x-heroicon-o-eye class="h-4 w-4" />
                            </button>
                            <button type="button" @click="hideAll()" class="text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors" title="Masquer tout">
                                <x-heroicon-o-eye-slash class="h-4 w-4" />
                            </button>
                        </div>
                    @endif
                </div>
                <div class="space-y-2 max-h-48 overflow-y-auto pr-1 custom-scrollbar">
                    @forelse($googleCalendars as $calendarId => $cal)
                        <button
                            type="button"
                            @click="toggle(@js($calendarId))"
                            :class="hidden.includes(@js($calendarId)) ? 'opacity-40 grayscale' : 'opacity-100'"
                            class="w-full flex items-center gap-2.5 text-sm text-gray-600 dark:text-gray-400 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all"
                            title="Afficher ou masquer ce calendrier"
                        >
                            <span class="h-3 w-3 rounded-full shrink-0 ring-2 ring-offset-1 ring-gray-200 dark:ring-gray-600" style="background:{{ $cal['color'] }}"></span>
                            <span class="truncate text-left">{{ $cal['name'] }}</span>
                        </button>
                    @empty
                        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 p-2">
                            <x-heroicon-o-information-circle class="h-4 w-4 shrink-0" />
                            <span>Aucun calendrier accessible</span>
                        </div>
                    @endforelse
                </div>
            </div>
        </div>

        {{-- Panneau principal : calendrier --}}
        <div class="lg:col-span-3">
            <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-gray-100 dark:border-gray-700">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <x-heroicon-o-calendar class="h-5 w-5 text-gray-500 dark:text-gray-400" />
                            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Calendrier</h3>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                            <span class="flex items-center gap-1">
                                <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                                CRM
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="h-2 w-2 rounded-full bg-green-500"></span>
                                Google
                            </span>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    {{-- Widget calendrier — rendu par Filament via getFooterWidgets() --}}
                </div>
            </div>
        </div>
    </div>

    @livewire('google-event-modal')

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 2px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #4b5563;
        }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #6b7280;
        }
    </style>
</x-filament-panels::page>
