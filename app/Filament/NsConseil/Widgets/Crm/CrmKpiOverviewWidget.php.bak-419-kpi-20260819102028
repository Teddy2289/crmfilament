<?php

namespace App\Filament\NsConseil\Widgets\Crm;

use App\Models\Opportunite;
use App\Models\Prospect;
use App\Models\Client;
use Filament\Widgets\StatsOverviewWidget as BaseWidget;
use Filament\Widgets\StatsOverviewWidget\Stat;
use Illuminate\Support\Facades\Log;

class CrmKpiOverviewWidget extends BaseWidget
{
    protected static ?int $sort = 1;

    protected int|string|array $columnSpan = 'full';



    public ?string $errorMessage = null;

    public function getHeading(): string
    {
        return '📊 KPIs CRM';
    }

    protected function getStats(): array
    {
        try {
            $user = auth()->user();
            
            // Base queries with user filtering if applicable
            $opportunitesQuery = Opportunite::query();
            $prospectsQuery = Prospect::query();
            $clientsQuery = Client::query();
            
            // Filter by user if not admin/supervisor
            if (!$user->hasRoleCache("admin") && !$user->hasRoleCache("superviseur") && !$user->isSuperAdmin()) {
                if ($user->hasRoleCache('teleprospecteur')) {
                    $prospectsQuery->where('teleprospecteur_id', $user->id);
                    $opportunitesQuery->where('assigne_a', $user->id);
                }
                if ($user->hasRoleCache('commercial')) {
                    $prospectsQuery->where('commercial_id', $user->id);
                    $clientsQuery->where('commercial_id', $user->id);
                }
            }

            // Calculate KPIs
            $totalOpportunites = $opportunitesQuery->count();
            $totalProspects = $prospectsQuery->count();
            $totalClients = $clientsQuery->count();
            
            // Conversion rates
            $tauxConversionOpp = $totalOpportunites > 0 
                ? round(($opportunitesQuery->clone()->where('statut', 'converti')->count() / $totalOpportunites) * 100, 1)
                : 0;
            
            $tauxConversionProspect = $totalProspects > 0
                ? round(($prospectsQuery->clone()->qualifies()->count() / $totalProspects) * 100, 1)
                : 0;

            // Pipeline value
            $valeurPipeline = $opportunitesQuery->clone()
                ->whereIn('statut', ['nouveau', 'en_cours_evaluation', 'qualifiee'])
                ->get()
                ->sum(function ($opp) {
                    return $opp->valeur_estimee;
                });

            // Activity this month
            $nouveauxProspectsMois = $prospectsQuery->clone()
                ->whereMonth('created_at', now()->month)
                ->whereYear('created_at', now()->year)
                ->count();

            return [
                Stat::make('Opportunités', $totalOpportunites)
                    ->description("Taux conversion: {$tauxConversionOpp}%")
                    ->descriptionIcon('heroicon-m-arrow-trending-up')
                    ->color('info')
                    ->chart([7, 12, 10, 14, 12, 15, $totalOpportunites]),

                Stat::make('Prospects', $totalProspects)
                    ->description("Qualifiés: {$tauxConversionProspect}%")
                    ->descriptionIcon('heroicon-m-check-circle')
                    ->color('warning')
                    ->chart([10, 15, 12, 18, 16, 20, $totalProspects]),

                Stat::make('Clients', $totalClients)
                    ->description('Actifs dans le CRM')
                    ->descriptionIcon('heroicon-m-users')
                    ->color('success')
                    ->chart([5, 8, 12, 15, 18, 22, $totalClients]),

                Stat::make('Valeur Pipeline', number_format($valeurPipeline, 0, ',', ' ') . ' €')
                    ->description('Potentiel estimé')
                    ->descriptionIcon('heroicon-m-currency-euro')
                    ->color('primary'),

                Stat::make('Nouveaux Prospects', $nouveauxProspectsMois)
                    ->description('Ce mois')
                    ->descriptionIcon('heroicon-m-calendar')
                    ->color('success'),
            ];
            
        } catch (\Exception $exception) {
            Log::error('CrmKpiOverviewWidget error', [
                'message' => $exception->getMessage(),
                'exception' => $exception,
            ]);
            
            $this->errorMessage = 'Impossible de charger les KPIs CRM';
            
            return [
                Stat::make('Erreur', '—')
                    ->description($this->errorMessage)
                    ->color('danger'),
            ];
        }
    }

    public static function canView(): bool
    {
        $user = auth()->user();
        return $user && ($user->hasRoleCache('admin') || $user->hasRoleCache('superviseur') || $user->hasRoleCache('teleprospecteur') || $user->hasRoleCache('commercial'));
    }
}
